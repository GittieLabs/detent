{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Settings window only: Tauri's defaults plus Detent's own commands (D-071). Dashboard windows get no capabilities (architecture: Security).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-get-state",
    "allow-start-pairing",
    "allow-end-pairing",
    "allow-pair",
    "allow-rename",
    "allow-mappings-of",
    "allow-unpair",
    "allow-ignore",
    "allow-unignore",
    "allow-set-paused",
    "allow-list-apps",
    "allow-set-dry-run",
    "allow-set-mapping",
    "allow-remove-mapping",
    "allow-apply-template",
    "allow-fix-accessibility",
    "allow-set-menu-item",
    "allow-remove-menu-item",
    "allow-move-menu-item",
    "allow-list-displays"
  ]
}
